{
  "name": "division",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "build:cloudflare": "vite build --base=/",
    "build:native": "vite build --base=./",
    "native:sync": "pnpm build:native && cap sync",
    "online:dev": "wrangler dev",
    "online:deploy": "pnpm build:cloudflare && wrangler deploy",
    "online:smoke": "node scripts/smoke-room.mjs && node scripts/smoke-online-rematch.mjs && node scripts/smoke-online-reconnect.mjs && node scripts/smoke-online-browser.mjs && node scripts/smoke-online-2v2-browser.mjs && node scripts/smoke-online-boss-browser.mjs",
    "audio:boss": "node scripts/build-boss-audio.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "@capacitor/core": "^8.6.0",
    "howler": "^2.2.4",
    "pixi.js": "^8.14.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/cli": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "playwright-core": "^1.64.1",
    "vite": "^7.1.0",
    "wrangler": "^4.156.0"
  }
}
