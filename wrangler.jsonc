{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "division",
  "main": "server/worker.js",
  "compatibility_date": "2026-10-30",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [
      { "name": "MATCH_ROOMS", "class_name": "MatchRoom" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["MatchRoom"] }
  ]
}
